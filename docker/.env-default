# Hermes Docker Compose — modelo de configuração
#
# Como usar:
#   cp .env-default .env
#   nano .env          # preencha os valores
#   docker compose up -d
#
# ⚠️  O .env tem segredos e NUNCA deve ir para o git.
#     Este modelo (.env-default) é versionado sem credenciais.
#
# O docker-compose.yml lê todas as variáveis daqui. Se uma variável não
# existir neste arquivo, o compose usa o valor padrão que está no próprio
# docker-compose.yml.

# ──────────────────────────────────────────────────────────────────────────
# Caminhos do HOST — pastas montadas nos containers
# ──────────────────────────────────────────────────────────────────────────
# Use ${HOME} (o compose resolve para a pasta do usuário do host).
# Assim o arquivo funciona em qualquer máquina, sem precisar editar.
HOST_HERMES_HOME=${HOME}/.hermes
HOST_HERMES_DATA=${HOME}/hermes-data
HOST_HERMES_WEBUI_WORKSPACE=${HOME}/hermes-data/hermes-webui/workspace

# ──────────────────────────────────────────────────────────────────────────
# UID / GID — número do usuário do host
# ──────────────────────────────────────────────────────────────────────────
# Descubra com:  id -u  (UID)  e  id -g  (GID)
# No macOS os números começam em 501 — ajuste.
UID=1000
GID=1000

# ──────────────────────────────────────────────────────────────────────────
# Hermes Agent (serviço hermes-agent)
# ──────────────────────────────────────────────────────────────────────────
HERMES_HOME=/home/hermes/.hermes
HERMES_DASHBOARD=1
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT=9119
API_SERVER_ENABLED=true
# 🔒 Segredo — gere um valor com:  openssl rand -hex 32
API_SERVER_KEY=CHANGE_ME
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8642

# ──────────────────────────────────────────────────────────────────────────
# Hermes WebUI (serviço hermes-webui)
# ──────────────────────────────────────────────────────────────────────────
HERMES_WEBUI_HOST=0.0.0.0
HERMES_WEBUI_PORT=8787
HERMES_WEBUI_STATE_DIR=/home/hermeswebui/.hermes/webui
# 🔒 Segredo — senha de acesso ao WebUI (obrigatória para acesso remoto)
HERMES_WEBUI_PASSWORD=CHANGE_ME
HERMES_API_URL=http://hermes-agent:8642
GATEWAY_HEALTH_URL=http://hermes-agent:8642/health
HERMES_WEBUI_GATEWAY_BASE_URL=http://hermes-agent:8642
# ⚠️ Mantenha 1 — contorna um bug do WebUI (correção ainda não lançada)
HERMES_NIX_BUILD=1
# Tempo de sessão do WebUI em segundos (padrão: 2592000 = 30 dias)
HERMES_WEBUI_SESSION_TTL=86400
# Evita que o WebUI altere permissões de arquivos de credenciais
HERMES_SKIP_CHMOD=1
