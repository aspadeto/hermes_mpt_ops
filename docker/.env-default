# Hermes Docker Compose — configuração (template)
#
# Copie para `.env` e preencha:
#   cp .env-default .env
#   nano .env
#
# ⚠️  NUNCA commitar o `.env` real (contém segredos). Este template (.env-default)
#     é versionado SEM credenciais — segredos ficam como CHANGE_ME/vazios.
#
# Todas as variáveis do docker-compose.yml são interpoladas daqui.
# O padrão (default) de cada uma está no próprio compose — este arquivo
# apenas sobrescreve quando precisa.

# ──────────────────────────────────────────────────────────────────────────
# Caminhos do HOST — volumes compartilhados
# ──────────────────────────────────────────────────────────────────────────
# ✅ PREFERÊNCIA: usar ${HOME} em vez do caminho absoluto — o Compose expande
#    com o home real do usuário do host (portátil entre máquinas).
HOST_HERMES_HOME=${HOME}/.hermes
HOST_HERMES_DATA=${HOME}/hermes-data
HOST_HERMES_WEBUI_WORKSPACE=${HOME}/hermes-data/hermes-webui/workspace

# ──────────────────────────────────────────────────────────────────────────
# UID / GID — mapeamento do usuário do host
# ──────────────────────────────────────────────────────────────────────────
# Descubra com:  id -u  (UID)  |  id -g  (GID)
# No macOS, UIDs começam em 501 — ajustar.
UID=1000
GID=1000

# ──────────────────────────────────────────────────────────────────────────
# Hermes Agent (serviço hermes-agent)
# ──────────────────────────────────────────────────────────────────────────
HERMES_HOME=/home/hermes/.hermes
HERMES_DASHBOARD=1
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT=9119
API_SERVER_ENABLED=true
# 🔒 SEGREDO — gerar com:  openssl rand -hex 32
API_SERVER_KEY=CHANGE_ME
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8642

# ──────────────────────────────────────────────────────────────────────────
# Hermes WebUI (serviço hermes-webui)
# ──────────────────────────────────────────────────────────────────────────
HERMES_WEBUI_HOST=0.0.0.0
HERMES_WEBUI_PORT=8787
HERMES_WEBUI_STATE_DIR=/home/hermeswebui/.hermes/webui
# 🔒 SEGREDO — senha de acesso ao WebUI (obrigatória p/ acesso remoto)
HERMES_WEBUI_PASSWORD=CHANGE_ME
HERMES_API_URL=http://hermes-agent:8642
GATEWAY_HEALTH_URL=http://hermes-agent:8642/health
HERMES_WEBUI_GATEWAY_BASE_URL=http://hermes-agent:8642
# ⚠️ Workaround bug #6441 do hermes-webui (fix em andamento) — manter 1
HERMES_NIX_BUILD=1
# Sessão do WebUI (segundos; default 2592000 = 30 dias)
HERMES_WEBUI_SESSION_TTL=86400
# Bypass do fixer de permissões de credenciais (bind mount)
HERMES_SKIP_CHMOD=1
